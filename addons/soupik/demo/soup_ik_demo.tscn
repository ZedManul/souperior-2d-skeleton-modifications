[node name="DemoText" type="RichTextLabel" parent="Wall of text" unique_id=2052485553]
layout_mode = 0
offset_left = -61.0
offset_top = -101.99999
offset_right = 653.99994
offset_bottom = 59.000008
scale = Vector2(0.2, 0.2)
text = "Welcome to Soup Demo :)
The idea behind new soup is to interact with the skeleton armature as little as possible.
Instead, you just bring out only the controls you need into a rig.
(Although this is just a suggestion and you can really use the ik nodes however you want, 
there are no hard-requirements. 
Just avoid transform loops and it should be fine.)
Feel free to play around with this rig!
"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DemoText2" type="RichTextLabel" parent="Wall of text" unique_id=643807906]
layout_mode = 0
offset_left = 29.0
offset_top = -53.0
offset_right = 498.99994
offset_bottom = 42.0
scale = Vector2(0.2, 0.2)
text = "There are strength settings for all rig controls,
so if multiple controls are affecting same group of bones, 
you can gradually reduce the effect of some. 
(try changing strength of the GunFK node)"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DemoText4" type="RichTextLabel" parent="Wall of text" unique_id=859790920]
layout_mode = 0
offset_left = 41.0
offset_top = -24.0
offset_right = 651.0
offset_bottom = 114.0
scale = Vector2(0.2, 0.2)
text = "q nodes in this version are actually 2D!
They also use themselves as targets by default
(i.e. a LookAt node will make the bone rotate to point at the LookAt node itself)
but if you prefer to use some other node2D as a target for a modification,
you still have the option to!
(Once again, be careful to avoid cyclic transform dependencies.)"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DemoText3" type="RichTextLabel" parent="Wall of text" unique_id=882810615]
layout_mode = 0
offset_left = -123.0
offset_top = -23.000002
offset_right = 356.0
offset_bottom = 92.0
scale = Vector2(0.2, 0.2)
text = "Works on negative scale too!
Try changing the scale on the Rig node.
(Still intended to only work with orthonormalized transforms, 
so if you change scale to anything thats not 1 or -1, 
or touch skew at all, i have no guarantees)"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DemoText7" type="RichTextLabel" parent="Wall of text" unique_id=1411305566]
layout_mode = 0
offset_left = -123.0
offset_top = 1.9999999
offset_right = 408.0
offset_bottom = 140.0
scale = Vector2(0.2, 0.2)
text = "in this case the rig also acts as a keeper of the rest pose for bones.
rest pose is important since otherwise things affected by jiggle, IK or 
any sort of soup bone in general end up drifting due to 
floating point imprecision.
it takes a while and usually requires the targets to move due 
to an animation node or something."
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DemoText5" type="RichTextLabel" parent="Wall of text" unique_id=1077310240]
layout_mode = 0
offset_left = -11.000002
offset_top = 20.0
