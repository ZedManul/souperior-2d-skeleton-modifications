offset_bottom = 135.0
scale = Vector2(0.2, 0.2)
text = "All modifications now have custom gizmos to go along with them!
You can configure their sizes and whatnot for each node individually to your liking.
Also, if you are using an optional target in a modification,
the gizmo will be glued to that instead!"
fit_content = true
scroll_active = false
autowrap_mode = 0

